---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const entries = (await getCollection('garden')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const icon = { seedling: '🌱', budding: '🌿', evergreen: '🌳' };
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="intro">
    <h1>Federico’s garden</h1>
    <p>Notes, readings and ideas that grow over time. Every page has a stage: <b>seedling</b> for an idea just born, <b>budding</b> for something I’m developing, <b>evergreen</b> for something I consider solid.</p>
  </section>
  <ul class="grid">
    {entries.map((e) => (
      <li>
        <a class={`card ${e.data.stage}`} href={`/garden/${e.id}/`}>
          <span class="stage">{icon[e.data.stage]} {e.data.stage}</span>
          <h2>{e.data.title}</h2>
          <span class="meta">{e.data.type}, {fmt(e.data.date)}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
